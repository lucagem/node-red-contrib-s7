{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Node-RED with S7 contrib",
            "type": "node",
            "request": "launch",
            "program": "${workspaceFolder}/node_modules/.bin/node-red",
            "args": [
                "--userDir",
                "${workspaceFolder}/test-flows",
                "--verbose"
            ],
            "console": "integratedTerminal",
            "restart": true,
            "autoAttachChildProcesses": true,
            "skipFiles": [
                "<node_internals>/**"
            ],
            "env": {
                "NODE_ENV": "development"
            }
        }
    ]
}