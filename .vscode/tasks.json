{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Restart Node-RED",
            "type": "shell",
            "command": "taskkill",
            "args": ["/F", "/IM", "node.exe"],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "silent",
                "focus": false,
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "Install S7 Module",
            "type": "shell",
            "command": "npm",
            "args": ["install"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "build"
        },
        {
            "label": "Link S7 Module",
            "type": "shell",
            "command": "npm",
            "args": ["link"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "build"
        }
    ]
}